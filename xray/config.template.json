{
  "log": {
    "access": "none",
    "dnsLog": false,
		"maskAddress": "half",
    "error": "none",
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 25392,
      "protocol": "trojan",
      "settings": {
        "clients": ${XRAY_CLIENTS}
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/helloworld"
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "warp",
      "protocol": "wireguard",
      "settings": {
        "mtu": ${WARP_MTU},
        "secretKey": "${WARP_PRIVATE_KEY}",
        "address": [
          "${WARP_IPV4}/32",
          "${WARP_IPV6}/128"
        ],
        "workers": 4,
        "domainStrategy": "ForceIP",
        "peers": [
          {
            "publicKey": "${WARP_PUBLIC_KEY}",
            "allowedIPs": [
              "0.0.0.0/0",
              "::/0"
            ],
            "endpoint": "${WARP_ENDPOINT}",
            "keepAlive": 25
          }
        ],
        "noKernelTun": true
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}